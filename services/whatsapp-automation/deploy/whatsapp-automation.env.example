PORT=8080
APP_BASE_URL=https://gestao-otica-pro.vercel.app
WHATSAPP_INTERNAL_SECRET=replace-with-a-long-random-secret
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-with-a-long-random-api-key
EVOLUTION_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
WHATSAPP_INBOUND_AGGREGATION_WINDOW_MS=20000
WHATSAPP_APP_REQUEST_TIMEOUT_MS=45000
# Watchdog e reconciliacao dos canais ativos cadastrados no app.
WHATSAPP_WATCHDOG_ENABLED=true
WHATSAPP_WATCHDOG_INTERVAL_MS=60000
WHATSAPP_WATCHDOG_RESTART_COOLDOWN_MS=300000
WHATSAPP_RECONCILIATION_ENABLED=true
WHATSAPP_RECONCILIATION_INTERVAL_MS=60000
WHATSAPP_RECONCILIATION_LOOKBACK_MS=86400000
WHATSAPP_ACTIVE_CHANNELS_REFRESH_MS=60000
