PORT=8080
APP_BASE_URL=https://gestao-otica-pro.vercel.app
WHATSAPP_INTERNAL_SECRET=replace-with-a-long-random-secret
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-with-a-long-random-api-key
EVOLUTION_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
WHATSAPP_INBOUND_AGGREGATION_WINDOW_MS=20000
WHATSAPP_APP_REQUEST_TIMEOUT_MS=45000
# Watchdog exclusivo da Loja 1. Reinicia apenas a instancia configurada se a
# Evolution deixar de informa-la como conectada.
WHATSAPP_STORE_ONE_WATCHDOG_ENABLED=true
WHATSAPP_STORE_ONE_WATCHDOG_INSTANCE_KEY=loja-1-otica-prisma-guaira
WHATSAPP_STORE_ONE_WATCHDOG_INTERVAL_MS=60000
WHATSAPP_STORE_ONE_WATCHDOG_RESTART_COOLDOWN_MS=300000
