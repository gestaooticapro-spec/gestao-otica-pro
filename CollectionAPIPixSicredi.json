            "body": {
              "mode": "raw",
              "raw": "{\n    \"calendario\": {\n        \"dataDeVencimento\": \"2025-10-30\",\n        \"validadeAposVencimento\": 0\n    },\n    \"devedor\": {\n        \"nome\": \"Fulano de tal\",\n        \"cpf\": \"00012312312\"\n    },\n    \"valor\": {\n        \"original\": \"0.30\",\n        \"multa\": {\n            \"modalidade\": 2,\n            \"valorPerc\": \"15.00\"\n        },\n        \"juros\": {\n            \"modalidade\": 2,\n            \"valorPerc\": \"2.00\"\n        },\n        \"desconto\": {\n            \"modalidade\": 2,\n            \"descontoDataFixa\": [\n                {\n                    \"data\": \"2025-09-20\",\n                    \"valorPerc\": \"30.00\"\n                }\n            ]\n        }\n    },\n    \"chave\": \"{{chavePix}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "let id =  utils.makeid(26);",
                  "bru.setVar(\"txid\",id);",
                  "// console.log(\"pm.collectionVariables.txid: \" + bru.getVar(\"txid\"));",
                  ""
                ]
              }
            }
