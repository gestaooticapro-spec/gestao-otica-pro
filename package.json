    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "next": "^15.5.20",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
