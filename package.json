{
  "name": "gestao-otica-pro",
  "version": "0.1.0",
  "description": "Aplicativo desktop da Torre MB Optical",
  "author": "MB Optical",
  "private": true,
  "main": "electron/main.cjs",
  "tower": {
    "productionUrl": "https://neosmart-eta.vercel.app/"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:electron": "concurrently --kill-others-on-fail --names next,electron \"npm:dev\" \"npm:electron:wait\"",
    "electron": "electron .",
    "electron:wait": "wait-on http-get://localhost:3000 && electron .",
    "pack:electron": "electron-builder --dir --win",
    "dist:electron": "electron-builder --win nsis",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:tower": "eslint electron/main.cjs electron/preload.cjs src/app/torre src/app/api/tower src/components/tower src/lib/server/tower-activation-rate-limit.ts src/lib/server/tower-device-web-session.ts src/lib/server/tower-maintenance-grant.ts src/lib/server/tower-remote-config.ts src/lib/server/tower-remote-config-session.ts src/lib/tower src/lib/actions/tower-assets.actions.ts src/lib/actions/tower-session.actions.ts src/lib/actions/tower-heatmap.actions.ts src/lib/actions/tower-measurement.actions.ts tests",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/tower-contracts.test.ts && node --test tests/electron-security.test.mjs tests/tower-local-database.test.mjs tests/tower-migration.test.mjs tests/tower-web-api-contracts.test.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/file-saver": "^2.0.7",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "crc": "^4.3.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.10.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "next": "14.2.35",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "three": "^0.169.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "br.com.mboptical.torre",
    "productName": "Torre MB Optical",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "torre-mb-optical",
      "icon": "public/web-app-manifest-512x512.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Torre MB Optical",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Torre-MB-Optical-Setup-${version}-${arch}.${ext}"
    }
  }
}
