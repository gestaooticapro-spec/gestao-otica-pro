# Gateway de mensalidade por loja (integracao-asaas)
NUVEM_LOCAL_COBRANCA_API_URL=
NUVEM_LOCAL_COBRANCA_CLIENT_KEY=
NUVEM_LOCAL_COBRANCA_CLIENT_SECRET=

# API Pix Sicredi — homologacao. Nunca versionar certificados, chave privada ou credenciais reais.
# Este projeto aceita somente https://api-pix-h.sicredi.com.br nesta etapa.
SICREDI_PIX_HML_BASE_URL=https://api-pix-h.sicredi.com.br
SICREDI_PIX_HML_CLIENT_ID=
SICREDI_PIX_HML_CLIENT_SECRET=
SICREDI_PIX_HML_PIX_KEY=
SICREDI_PIX_HML_CHARGE_EXPIRATION_SECONDS=86400
# Os caminhos abaixo usam os defaults locais em .sicredicharles/ quando omitidos.
SICREDI_PIX_CERT_PATH=
SICREDI_PIX_KEY_PATH=
SICREDI_PIX_CA_PATH=
