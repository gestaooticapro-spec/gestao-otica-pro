# Gateway de mensalidade por loja (integracao-asaas)
NUVEM_LOCAL_COBRANCA_API_URL=
NUVEM_LOCAL_COBRANCA_CLIENT_KEY=
NUVEM_LOCAL_COBRANCA_CLIENT_SECRET=

# API Pix Sicredi — producao. Nunca versionar certificados, chave privada ou credenciais reais.
# A integracao e liberada no codigo somente para a loja-piloto configurada com Pix Sicredi.
# Configuracao ativa: producao, restrita no codigo a loja-piloto com Pix Sicredi habilitado.
SICREDI_PIX_PROD_BASE_URL=https://api-pix.sicredi.com.br
SICREDI_PIX_PROD_CLIENT_ID=
SICREDI_PIX_PROD_CLIENT_SECRET=
SICREDI_PIX_PROD_PIX_KEY=
SICREDI_PIX_PROD_CHARGE_EXPIRATION_SECONDS=86400
# Em hospedagem, informe os tres PEMs em Base64 como segredos. Eles tem prioridade sobre caminhos.
SICREDI_PIX_PROD_CERT_PEM_BASE64=
SICREDI_PIX_PROD_KEY_PEM_BASE64=
SICREDI_PIX_PROD_CA_PEM_BASE64=
# Os caminhos abaixo usam os defaults locais em .sicredicharles/ quando omitidos e servem apenas ao desenvolvimento local.
SICREDI_PIX_PROD_CERT_PATH=
SICREDI_PIX_PROD_KEY_PATH=
SICREDI_PIX_PROD_CA_PATH=
SICREDI_PIX_PROD_KEY_PASSPHRASE=

# Segmentacao de lentes do tablet (servico na VPS, isolado do WhatsApp e da Torre).
LENS_SEGMENT_INTERNAL_SECRET=
LENS_SEGMENT_URL=
# Origem que o app envia ao chamar a VPS (precisa estar na allowlist do servico).
LENS_SEGMENT_FORWARD_ORIGIN=https://gestao-otica-pro.vercel.app

# Modelos OpenAI do backend. Chaves de API devem permanecer somente no servidor.
OPENAI_TEXT_MODEL=gpt-5.4-mini
WHATSAPP_AI_OPENAI_MODEL=gpt-5.4-mini
# Sobrescritas opcionais; vazias herdam o modelo geral ou o do WhatsApp.
OPENAI_VISION_MODEL=
DAILY_STORE_HEALTH_OPENAI_MODEL=
WHATSAPP_AI_OPENAI_ORDER_HANDOFF_MODEL=
WHATSAPP_AI_OPENAI_CLASSIFICATION_MODEL=
WHATSAPP_AI_OPENAI_ORDER_STATUS_MODEL=
# Alternativas de texto, separadas por virgula; vazio usa somente o modelo principal.
OPENAI_TEXT_FALLBACK_MODELS=
