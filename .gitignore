# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/dist-electron/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- CUSTOM PROJECT IGNORES ---

# Temporary/Data folders
/tmp/
/.tabelas/
/.agent/
/.claude/
/.migracao_nfce/
/supabase/.temp/
/scripts/__pycache__/

# Heavy Files & Archives
*.pdf
Guia_tecnico_integracao_APIPix_Sicredi_v2.1.pdf
CollectionAPIPixSicredi.json
*.zip
*.rar
*.7z
*.xlsx

