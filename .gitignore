# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- CUSTOM PROJECT IGNORES ---

# Temporary/Data folders
/tmp/
/.tabelas/
/.agent/
/.claude/
/.migracao_nfce/

# Heavy Files & Archives
*.pdf
*.zip
*.rar
*.7z
*.xlsx

# Data Snapshots (CSV files in root and elsewhere)
*.csv

# SQL & Backups (Keep migrations, ignore others)
*.sql
!supabase_migration_*.sql
!src/lib/database/*.sql

# System & Local Logs
*.log
PROJETO_COMPLETO_IA.txt
build.log
